  "nodes": [
    {
      "id": "R25-TITLE",
      "type": "text",
      "text": "# 《青山》R25 人物×组织关系总览\n本次29个种子人物／23条人物边／12条人物→组织边\nR24组织树114对象原样保留｜P?｜十元未定",
      "x": 600,
      "y": -230,
      "width": 1400,
      "height": 180,
      "color": "3"
    },
    {
      "id": "R25-DATA",
      "type": "file",
      "file": "09-给674（我）用的库/概念库/环境概念设计总库/06_社会结构/青山_人物采集/青山_R25_人物系统_阶段总表_20261121.md",
      "x": 2090,
      "y": -230,
