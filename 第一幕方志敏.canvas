			"y": -320,
			"width": 260,
			"height": 60
		},
		{
			"id": "fcc1d1fd0a4348e1",
			"type": "text",
			"text": "什么！  ",
			"styleAttributes": {},
			"x": 1300,
			"y": -250,
			"width": 260,
			"height": 60
		},
		{
			"id": "d08b82f5576feec8",
			"type": "text",
			"text": "方志敏听到 眉头一紧就冲了出去",
			"styleAttributes": {},
			"x": 1300,
			"y": -178,
			"width": 260,
