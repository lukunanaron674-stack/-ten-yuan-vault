			"file": "Pasted image 20260731222522.png",
			"x": 840,
			"y": -875,
			"width": 400,
			"height": 300
		},
		{
			"id": "5b4015c0a89954ad",
			"type": "text",
			"text": "可算摆脱围剿了，  是啊",
			"styleAttributes": {},
			"x": 1300,
			"y": -494,
			"width": 260,
			"height": 60
		},
		{
			"id": "0ad3e05f76c4a712",
			"type": "text",
			"text": "切中景",
			"styleAttributes": {},
			"x": 1040,
			"y": -320,
			"width": 260,
			"height": 60
		},
		{
			"id": "a7a9eb4bced63137",
			"type": "text",
			"text": "主席！不好啦",
			"styleAttributes": {},
			"x": 1300,
			"y": -403,
			"width": 260,
			"height": 60
		},
		{
			"id": "44bf3980aa87a38a",
			"type": "text",
			"text": "还有一群同志在山中迷路没出来！",
			"styleAttributes": {},
			"x": 1300,
			"y": -320,
			"width": 260,
			"height": 60
		},
		{
			"id": "fcc1d1fd0a4348e1",
			"type": "text",
			"text": "什么！  ",
			"styleAttributes": {},
			"x": 1300,
			"y": -250,
			"width": 260,
			"height": 60
		},
		{
			"id": "d08b82f5576feec8",
			"type": "text",
			"text": "方志敏听到 眉头一紧就冲了出去",
			"styleAttributes": {},
			"x": 1300,
			"y": -178,
			"width": 260,
			"height": 60
		},
		{
			"id": "bb9a46fc872f12eb",
			"type": "text",
			"text": "背上抗日",
			"styleAttributes": {},
