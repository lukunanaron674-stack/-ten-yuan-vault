filters:
  or:
    - and:
        - file.inFolder("方/05_画布工作台/卡级状态")
        - 类型 == "卡级管理"
        - 幕 == "第五幕"
    - and:
        - file.inFolder("方/04_声音设计/幕级")
        - 类型 == "幕级声音"
        - 幕 == "第五幕"
properties:
  幕:
    displayName: 幕
  卡号:
    displayName: 卡号
  子制作:
    displayName: 子制作
  5-2A-a:
    displayName: 5-2A-a
  5-2A-b:
    displayName: 5-2A-b
  5-2A-c:
    displayName: 5-2A-c
  名称:
    displayName: 名称
  阶段编号:
    displayName: 阶段（1—5）
  锁定:
    displayName: 锁卡
  环境音:
    displayName: 环境音
  氛围音:
    displayName: 氛围音
  状态:
    displayName: 状态
  缺什么:
    displayName: 缺什么
views:
  - type: table
    name: 第五幕｜8卡总表
    filters:
      and:
        - 类型 == "卡级管理"
        - 幕 == "第五幕"
        - 卡号 != "5-2A"
    order:
      - 卡号
      - 名称
      - 子制作
      - 阶段编号
      - 缺什么
      - 锁定
  - type: table
    name: 第五幕｜5-2A｜a／b／c 三栏
    filters:
      and:
        - 类型 == "卡级管理"
        - 幕 == "第五幕"
        - or:
            - 卡号 == "5-2A-a"
            - 卡号 == "5-2A-b"
            - 卡号 == "5-2A-c"
    order:
      - 卡号
      - 名称
      - 子制作
      - 阶段编号
      - 状态
      - 缺什么
      - 锁定
  - type: table
    name: 第五幕｜声音确认
    filters:
      and:
        - 类型 == "幕级声音"
        - 幕 == "第五幕"
    order:
      - 幕
      - 环境音
      - 氛围音
      - 缺什么
      - 状态
