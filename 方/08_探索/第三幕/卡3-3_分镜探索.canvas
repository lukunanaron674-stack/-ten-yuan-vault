{
    "nodes":  [
                  {
                      "id":  "title",
                      "type":  "text",
                      "text":  "⏱ 分镜探索｜卡3-3｜v1.1",
                      "x":  -150,
                      "y":  -700,
                      "width":  300,
                      "height":  50,
                      "color":  "6"
                  },
                  {
                      "id":  "hub",
                      "type":  "text",
                      "text":  "⏱ 分镜描述 ×10｜卡3-3 告发与调走\n\n一句话：8s落下窥见、告状、拍板三拍。\n\n📄 [[方/08_探索/第三幕/卡3-3_文章暴露_探索.md|完整×10与评分]]",
                      "x":  -220,
                      "y":  -460,
                      "width":  440,
                      "height":  150,
                      "color":  "5"
                  },
                  {
                      "id":  "t1",
                      "type":  "text",
                      "text":  "第1名｜9.4｜0—2s窥见；2—5.5s告状；5.5—8s拍桌下令、由贪转怕。",
                      "x":  496,
                      "y":  116,
                      "width":  360,
                      "height":  130,
                      "color":  "4"
                  },
                  {
                      "id":  "t2",
                      "type":  "text",
                      "text":  "第2名｜9.0｜1.5s窥视＋1s脚步声桥＋3s告状＋2.5s拍板。",
                      "x":  465,
                      "y":  307,
                      "width":  360,
                      "height":  130,
                      "color":  "3"
                  },
                  {
                      "id":  "t3",
                      "type":  "text",
                      "text":  "第3名｜8.8｜先说凌护方，再补方写稿，最后限令。",
                      "x":  379,
                      "y":  494,
                      "width":  360,
                      "height":  130,
                      "color":  "3"
                  },
                  {
                      "id":  "t4",
                      "type":  "text",
                      "text":  "第4名｜8.6｜栏眼特写→桌边汇报→抬眼拍桌，留0.3s停顿。",
                      "x":  238,
                      "y":  658,
                      "width":  360,
                      "height":  130,
                      "color":  "3"
                  },
                  {
                      "id":  "t5",
                      "type":  "text",
                      "text":  "第5名｜8.3｜窥见→快步进门→告状→缩肩。",
                      "x":  48,
                      "y":  785,
                      "width":  360,
                      "height":  130,
                      "color":  "1"
                  },
                  {
                      "id":  "t6",
                      "type":  "text",
                      "text":  "第6名｜8.1｜固定栏缝＋固定办公室，动作最少。",
                      "x":  -180,
                      "y":  860,
                      "width":  360,
                      "height":  130,
                      "color":  "1"
                  },
                  {
                      "id":  "t7",
                      "type":  "text",
                      "text":  "第7名｜7.9｜阴影窥视→低声告状→合文件下令。",
                      "x":  -431,
                      "y":  872,
                      "width":  360,
                      "height":  130,
                      "color":  "1"
                  },
                  {
                      "id":  "t8",
                      "type":  "text",
                      "text":  "第8名｜7.6｜高层慢半拍反应后拍桌指门。",
                      "x":  -687,
                      "y":  814,
                      "width":  360,
                      "height":  130,
                      "color":  "1"
                  },
                  {
                      "id":  "t9",
                      "type":  "text",
                      "text":  "第9名｜7.2｜贴桌低声告密，高层突然打断限令。",
                      "x":  -930,
                      "y":  685,
                      "width":  360,
                      "height":  130,
                      "color":  "1"
                  },
                  {
                      "id":  "t10",
                      "type":  "text",
                      "text":  "第10名｜6.7｜跟拍跑入＋推近拍桌，稳定性风险最高。",
                      "x":  -1137,
                      "y":  487,
                      "width":  360,
                      "height":  130,
                      "color":  "1"
                  }
              ],
