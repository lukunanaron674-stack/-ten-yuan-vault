    "nodes":  [
                  {
                      "id":  "title",
                      "type":  "text",
                      "text":  "⏱ 分镜探索×10｜卡3-7｜v1.1",
                      "x":  -150,
                      "y":  -700,
                      "width":  300,
                      "height":  50,
                      "color":  "6"
                  },
                  {
                      "id":  "hub",
                      "type":  "text",
                      "text":  "卡3-7｜分镜×10\n\n14s：红吞纸＋三人同框＋拖拽＋断臂＋红灌屏，三句画外音逐拍落下\n\n📄 [[方/08_探索/第三幕/卡3-7_母亲恶魔_探索.md|完整×10与评分]]",
                      "x":  -220,
                      "y":  -460,
                      "width":  440,
                      "height":  150,
                      "color":  "5"
                  },
                  {
                      "id":  "n1",
                      "type":  "text",
                      "text":  "第1名｜9.6｜0—2s恶魔；2—5s同框；5—8s你敢割；8—11s断臂；11—14s救救母亲。",
                      "x":  496,
                      "y":  116,
                      "width":  360,
                      "height":  144,
                      "color":  "4"
                  },
                  {
                      "id":  "n2",
                      "type":  "text",
                      "text":  "第2名｜9.2｜1.5s染红＋3.5s低机位举刀＋4s一压一割＋5s两次攻击。",
                      "x":  465,
                      "y":  307,
                      "width":  360,
                      "height":  130,
                      "color":  "3"
                  },
                  {
                      "id":  "n3",
                      "type":  "text",
                      "text":  "第3名｜9.0｜母亲先独立护胸，再被围住；纯红保留护胸黑影。",
                      "x":  379,
                      "y":  494,
                      "width":  360,
                      "height":  130,
                      "color":  "3"
                  },
                  {
                      "id":  "n4",
                      "type":  "text",
                      "text":  "第4名｜8.8｜红线闭合→化地面→母亲站起→胖踩瘦拖→血弧。",
                      "x":  238,
                      "y":  658,
                      "width":  360,
                      "height":  130,
                      "color":  "3"
                  },
                  {
                      "id":  "n5",
                      "type":  "text",
                      "text":  "第5名｜8.6｜三次固定构图钉三句台词，动作最少。",
                      "x":  48,
                      "y":  785,
                      "width":  360,
                      "height":  130,
                      "color":  "1"
                  },
                  {
                      "id":  "n6",
                      "type":  "text",
                      "text":  "第6名｜8.4｜母亲独站3s后双鬼入画，情绪更慢。",
                      "x":  -180,
                      "y":  860,
                      "width":  360,
                      "height":  130,
                      "color":  "1"
                  },
                  {
                      "id":  "n7",
                      "type":  "text",
                      "text":  "第7名｜8.1｜胖鬼低机位压场→瘦鬼刀尖进入→单刀→单刺。",
                      "x":  -431,
                      "y":  872,
                      "width":  360,
                      "height":  130,
                      "color":  "1"
                  },
                  {
                      "id":  "n8",
                      "type":  "text",
                      "text":  "第8名｜7.8｜远景落前两句，两个近景完成攻击与末句。",
                      "x":  -687,
                      "y":  814,
                      "width":  360,
                      "height":  130,
                      "color":  "1"
                  },
                  {
                      "id":  "n9",
                      "type":  "text",
                      "text":  "第9名｜7.4｜拖拽后仰再站稳，红潮从下漫满。",
                      "x":  -930,
                      "y":  685,
                      "width":  360,
                      "height":  130,
                      "color":  "1"
                  },
                  {
                      "id":  "n10",
                      "type":  "text",
                      "text":  "第10名｜6.8｜三次几何硬切，动作与角色稳定性最低。",
                      "x":  -1137,
                      "y":  487,
                      "width":  360,
                      "height":  130,
                      "color":  "1"
                  }
              ],
