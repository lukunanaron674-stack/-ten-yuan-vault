{
    "nodes":  [
                  {
                      "id":  "title",
                      "type":  "text",
                      "text":  "⏱ 分镜探索｜卡1-2｜v1.0",
                      "x":  -150,
                      "y":  -700,
                      "width":  300,
                      "height":  50,
                      "color":  "6"
                  },
                  {
                      "id":  "hub",
                      "type":  "text",
                      "text":  "⏱ 分镜描述 ×10｜卡1-2 乡野·母亲般的中国\n\n一句话：15s 图A→图B，四句画外音各钉一拍。\n\n📄 [[方/08_探索/第一幕/卡1-2_母亲意象_探索.md|完整×10与评分]]",
                      "x":  -220,
                      "y":  -460,
                      "width":  440,
                      "height":  150,
                      "color":  "5"
                  },
                  {
                      "id":  "t1",
                      "type":  "text",
                      "text":  "第1名｜9.7｜前推→叠化→横移→停稳，四句各钉一拍，动效只贴水雾炊烟竹叶。",
                      "x":  496,
                      "y":  116,
                      "width":  360,
                      "height":  130,
                      "color":  "4"
                  },
                  {
                      "id":  "t2",
                      "type":  "text",
                      "text":  "第2名｜9.3｜前段更静，后段全静留白，末句压雾上。",
                      "x":  465,
                      "y":  307,
                      "width":  360,
                      "height":  130,
                      "color":  "3"
                  },
                  {
                      "id":  "t3",
                      "type":  "text",
                      "text":  "第3名｜9.0｜远山雾先动，田区层次扫过，末句更轻。",
                      "x":  379,
                      "y":  494,
                      "width":  360,
                      "height":  130,
                      "color":  "3"
                  },
                  {
                      "id":  "t4",
                      "type":  "text",
                      "text":  "第4名｜8.7｜动效最少，最温柔，节奏稍慢。",
                      "x":  238,
                      "y":  658,
                      "width":  360,
                      "height":  130,
                      "color":  "3"
                  },
                  {
                      "id":  "t5",
                      "type":  "text",
                      "text":  "第5名｜8.5｜切点前移，尾段留白更长。",
                      "x":  48,
                      "y":  785,
                      "width":  360,
                      "height":  130,
                      "color":  "1"
                  },
                  {
                      "id":  "t6",
                      "type":  "text",
                      "text":  "第6名｜8.2｜田区层次先入画，结构清楚温度略低。",
                      "x":  -180,
                      "y":  860,
                      "width":  360,
                      "height":  130,
                      "color":  "1"
                  },
                  {
                      "id":  "t7",
                      "type":  "text",
                      "text":  "第7名｜8.0｜句间留气口，情感更沉。",
                      "x":  -431,
                      "y":  872,
                      "width":  360,
                      "height":  130,
                      "color":  "1"
                  },
                  {
                      "id":  "t8",
                      "type":  "text",
                      "text":  "第8名｜7.7｜雾穿村庄命运感强，锁定风险上升。",
                      "x":  -687,
                      "y":  814,
                      "width":  360,
                      "height":  130,
                      "color":  "1"
                  },
                  {
                      "id":  "t9",
                      "type":  "text",
                      "text":  "第9名｜7.3｜静感最强，变化最少易散注意力。",
                      "x":  -930,
                      "y":  685,
                      "width":  360,
                      "height":  130,
                      "color":  "1"
                  },
                  {
                      "id":  "t10",
                      "type":  "text",
                      "text":  "第10名｜6.8｜动效超量，岸线建筑漂移风险最高。",
                      "x":  -1137,
                      "y":  487,
                      "width":  360,
                      "height":  130,
                      "color":  "1"
                  }
              ],
