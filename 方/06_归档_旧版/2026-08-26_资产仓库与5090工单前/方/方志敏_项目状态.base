filters:
  and:
    - file.inFolder("方/05_画布工作台/卡级状态")
    - 类型 == "卡级管理"
    - 锁定 != true
properties:
  幕:
    displayName: 幕
  卡号:
    displayName: 卡号
  名称:
    displayName: 名称
  画面描述词:
    displayName: ① 画面描述词
  当前画面:
    displayName: ② 当前画面
  分镜时间描述词:
    displayName: ③ 分镜时间
  视频:
    displayName: ④ 视频
  音效配音:
    displayName: ⑤ 音效／配音
  卡Canvas:
    displayName: 卡 Canvas
