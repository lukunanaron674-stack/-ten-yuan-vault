			"id":"98fd7cb1e18e2389",
			"type":"text",
			"text":"分镜",
			"styleAttributes":{},
			"x":800,
			"y":-4980,
			"width":260,
			"height":60
		},
		{
			"id":"b87dc35bccb95836",
			"type":"text",
			"text":"第一幕",
			"styleAttributes":{},
			"x":1240,
			"y":-4410,
			"width":260,
