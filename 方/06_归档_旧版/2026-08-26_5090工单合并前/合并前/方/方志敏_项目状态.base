filters:
  or:
    - and:
        - file.inFolder("方/05_画布工作台/卡级状态")
        - 类型 == "卡级管理"
    - and:
        - file.inFolder("方/05_画布工作台/5090工单")
        - 类型 == "5090工单"
    - and:
        - file.inFolder("方/04_声音设计/幕级")
        - 类型 == "幕级声音"
properties:
  幕:
    displayName: 幕
  卡号:
    displayName: 卡号
  名称:
    displayName: 名称
  当前阶段:
    displayName: 当前阶段
  阶段编号:
