# Copy to a protected local environment; do not commit secrets.
H3CLOUD_SSH_TARGET=h3cloud
# Remote command must submit to the already-running ComfyUI/H3 service and print job_id as its last line.
H3CLOUD_SUBMIT_COMMAND=python3 /opt/fzm_h3/submit_task.py --task \"{task}\"
# Optional cancellation command receives {job_id}.
H3CLOUD_CANCEL_COMMAND=python3 /opt/fzm_h3/cancel_task.py --job-id \"{job_id}\"
