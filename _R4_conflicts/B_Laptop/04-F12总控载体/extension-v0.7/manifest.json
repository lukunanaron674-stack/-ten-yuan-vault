{
  "manifest_version": 3,
  "name": "Ten Yuan F12 Controller v1.4.2",
  "version": "1.4.2",
  "description": "F12 controller with local generated-image export",
  "permissions": ["storage", "tabs", "activeTab", "scripting", "sidePanel", "alarms"],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://lazymanchat.com/*",
    "http://127.0.0.1:17312/*",
    "http://localhost:17312/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*", "https://lazymanchat.com/*"],
      "js": ["content.js"],
      "css": ["overlay.css"],
      "run_at": "document_idle"
    }
  ]
}
