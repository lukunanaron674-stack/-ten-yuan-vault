{
	"nodes":[
		{"id":"Br","type":"text","x":0,"y":-620,"width":1200,"height":300,"text":"# R4.1 B｜身份阶级与社会位置\n8题材×12节点运行骨架\n⚠ 非理论正本：入口主辅仅为候选；案例回填前均为 topic_node_incomplete","color":"4"},
		{"id":"Bm","type":"file","x":1350,"y":-620,"width":620,"height":300,"file":"013_AI用素材库/06B_韩漫题材对象行为库_十元分析版/28_64题材完全节点化重构/B_身份阶级与社会位置_节点化.md"},
		{"id":"Bnote","type":"text","x":2100,"y":-620,"width":1800,"height":300,"text":"## 运行纪律\n题材名不继承十元｜逐阶段重判主次｜已锁定/研究中关系分账｜动态链必须写接管条件、分支、结算与稳定锚点","color":"2"},
		{"id":"B0g","type":"group","x":0,"y":0,"width":5000,"height":1450,"label":"T-B01｜财阀继承｜12节点｜骨架候选","color":"5"},
		{"id":"B00","type":"text","x":100,"y":100,"width":1080,"height":330,"text":"## 0入口\n初始候选主x｜辅zx/xn/x并z\n非固定主导；逐阶段重判","color":"4"},
		{"id":"B01","type":"text","x":1300,"y":100,"width":1080,"height":330,"text":"## 1对象\n主：表决权与实际控制范围\n关联：股份/职位/资格/婚约接口\n异质对象不得混成同一变量","color":"3"},
		{"id":"B02","type":"text","x":2500,"y":100,"width":1080,"height":330,"text":"## 2主体\n继承候选／现掌权者／董事会与家族确认机构\n分开稳定本体、阶段状态、关系功能","color":"3"},
		{"id":"B03","type":"text","x":3700,"y":100,"width":1080,"height":330,"text":"## 3关系\n权限：定义/退出/资源/解释\n功能：承载/认可\n必须写明各自主体","color":"3"},
		{"id":"B04","type":"text","x":100,"y":530,"width":1080,"height":330,"text":"## 4触发\n资格争夺或权力真空\n待回填：行动者/对象/目的/回应/收益/代价","color":"3"},
		{"id":"B05","type":"text","x":1300,"y":530,"width":1080,"height":330,"text":"## 5状态\n名义资格→实际表决与调用权争夺→控制范围和职位壳重分配\n查不可逆变量：表决/否决/代表权","color":"2"},
		{"id":"B06","type":"text","x":2500,"y":530,"width":1080,"height":330,"text":"## 6端点\nA资格争议：x并z/z候选\nB控制争夺：x接管候选\nC职位壳：x生x并z候选\n体量/顺序待案例回填","color":"5"},
		{"id":"B07","type":"text","x":3700,"y":530,"width":1080,"height":330,"text":"## 7生克补\n已锁定候选：x生x并z、xn克zx\n须证明机制和变量\n继承/有钱不自动成立","color":"5"},
		{"id":"B08","type":"text","x":100,"y":960,"width":1080,"height":330,"text":"## 8动态链\n资格壳争议(x并z/z) →【控制争夺启动】→ x接管 →【对外调用需要】→ x生x并z → 新壳进入下一轮\n须写主体与结算","color":"5"},
		{"id":"B09","type":"text","x":1300,"y":960,"width":1080,"height":330,"text":"## 9主题\n暂不升格\n只有长期组织+认可节点构成中心问题时，才登记时间候选","color":"3"},
		{"id":"B0a","type":"text","x":2500,"y":960,"width":1080,"height":330,"text":"## 10反证\n有钱/持股/被称继承人≠x\n无调用、调配、否决或限制边界则主x失败","color":"2"},
		{"id":"B0b","type":"text","x":3700,"y":960,"width":1080,"height":330,"text":"## 11输出\n对象状态卡/双主体权限卡/阶段端点卡/机制卡/逐段链/反证卡","color":"2"},
		{"id":"B1g","type":"group","x":5200,"y":0,"width":5000,"height":1450,"label":"T-B02｜真假继承人｜12节点｜骨架候选","color":"5"},
		{"id":"B10","type":"text","x":5300,"y":100,"width":1080,"height":330,"text":"## 0入口\n初始候选主x并z｜辅x/z/zn\n非固定主导","color":"4"},
		{"id":"B11","type":"text","x":6500,"y":100,"width":1080,"height":330,"text":"## 1对象\n主：承担识别与准入的身份壳\n关联：姓名/血统凭证/财产入口/真实自我\n分别记录","color":"3"},
		{"id":"B12","type":"text","x":7700,"y":100,"width":1080,"height":330,"text":"## 2主体\n真假继承人／家族确认者／证据持有者／资源控制者\n“真实”与“被采用”分账","color":"3"},
		{"id":"B13","type":"text","x":8900,"y":100,"width":1080,"height":330,"text":"## 3关系\n谁定义身份、控制证据和准入\n谁认可、承载并维护公共壳","color":"3"},
		{"id":"B14","type":"text","x":5300,"y":530,"width":1080,"height":330,"text":"## 4触发\n凭证出现／身份被质疑／确认主体改口\n行动链待回填","color":"3"},
		{"id":"B15","type":"text","x":6500,"y":530,"width":1080,"height":330,"text":"## 5状态\n错误壳运行→壳与内部真实分裂→确认主体分别改判/拒绝→准入资源重归因","color":"2"},
		{"id":"B16","type":"text","x":7700,"y":530,"width":1080,"height":330,"text":"## 6端点\nA x并z主导识别\nB x与z分账\nC重新检查x生x并z/x并z生z","color":"5"},
		{"id":"B17","type":"text","x":8900,"y":530,"width":1080,"height":330,"text":"## 7生克补\n已锁定候选：x并z生z/x生x并z/x克z\nx补zn仅候选，须查正本","color":"5"},
		{"id":"B18","type":"text","x":5300,"y":960,"width":1080,"height":330,"text":"## 8动态链\n既有壳(x并z)→【证据/确认冲突】→证据控制(x)与确认(z)分账→旧壳维持/失效→新壳或多确认分裂","color":"5"},
		{"id":"B19","type":"text","x":6500,"y":960,"width":1080,"height":330,"text":"## 9主题\n本体候选\n需中心问题、转折、高潮和结局共同显影","color":"3"},
		{"id":"B1a","type":"text","x":7700,"y":960,"width":1080,"height":330,"text":"## 10反证\n秘密/DNA/换名≠x并z\n身份壳必须承担识别、准入或关系角色","color":"2"},
		{"id":"B1b","type":"text","x":8900,"y":960,"width":1080,"height":330,"text":"## 11输出\n身份壳卡/确认分账卡/证据控制卡/准入变化卡/逐段链/反证卡","color":"2"},
		{"id":"B2g","type":"group","x":0,"y":1600,"width":5000,"height":1450,"label":"T-B03｜豪门复仇｜12节点｜骨架候选","color":"5"},
		{"id":"B20","type":"text","x":100,"y":1700,"width":1080,"height":330,"text":"## 0入口\n初始候选主x｜辅xn/zx/z\n逐阶段重判","color":"4"},
		{"id":"B21","type":"text","x":1300,"y":1700,"width":1080,"height":330,"text":"## 1对象\n主：被夺且可重新掌握的具体边界\n关联：股份/证据/渠道/署名/继承权\n必须选主对象","color":"3"},
		{"id":"B22","type":"text","x":2500,"y":1700,"width":1080,"height":330,"text":"## 2主体\n被夺者／豪门控制者／盟友／公众或机构确认者\n夺回、控制、认可分账","color":"3"},
		{"id":"B23","type":"text","x":3700,"y":1700,"width":1080,"height":330,"text":"## 3关系\n控制证据渠道/退出否决/解释旧案/确认署名责任\n逐主体填写","color":"3"},
		{"id":"B24","type":"text","x":100,"y":2130,"width":1080,"height":330,"text":"## 4触发\n旧案证据、被害者回归或控制漏洞\n具体行动链待回填","color":"3"},
		{"id":"B25","type":"text","x":1300,"y":2130,"width":1080,"height":330,"text":"## 5状态\n掌握边界丧失→资源证据组织→控制/署名入口夺回→公众评价另作z分账","color":"2"},
		{"id":"B26","type":"text","x":2500,"y":2130,"width":1080,"height":330,"text":"## 6端点\n失去：x↓\n组织：xn候选\n公开反击：zx候选\n结算：x恢复与z确认分开","color":"5"},
		{"id":"B27","type":"text","x":3700,"y":2130,"width":1080,"height":330,"text":"## 7生克补\nx克z/xn克zx/xn补z/z补xn均须逐段证明\n禁止成套调用","color":"5"},
		{"id":"B28","type":"text","x":100,"y":2560,"width":1080,"height":330,"text":"## 8动态链\nx丧失→【长期组织】xn接管→【公开窗口】zx可接管→x重新归属→具体z确认/拒绝\n每段写接管条件","color":"5"},
		{"id":"B29","type":"text","x":1300,"y":2560,"width":1080,"height":330,"text":"## 9主题\n时间候选仅在长期组织+最终确认共同构成中心问题时成立","color":"3"},
		{"id":"B2a","type":"text","x":2500,"y":2560,"width":1080,"height":330,"text":"## 10反证\n复仇情绪/打脸/对手失败≠zx\n看公开权能与具体夺回边界","color":"2"},
		{"id":"B2b","type":"text","x":3700,"y":2560,"width":1080,"height":330,"text":"## 11输出\n被夺对象卡/计划卡/显权卡/控制恢复卡/认可分账卡/反证卡","color":"2"},
		{"id":"B3g","type":"group","x":5200,"y":1600,"width":5000,"height":1450,"label":"T-B04｜娱乐圈上位｜12节点｜骨架候选","color":"5"},
		{"id":"B30","type":"text","x":5300,"y":1700,"width":1080,"height":330,"text":"## 0入口\n初始候选主z｜辅x并z/zx/x\n认可主体必须分账","color":"4"},
		{"id":"B31","type":"text","x":6500,"y":1700,"width":1080,"height":330,"text":"## 1对象\n主：被具体主体确认的作品/能力/身份/选择\n关联：人设壳/渠道/署名/评价\n流量不是统一对象","color":"3"},
		{"id":"B32","type":"text","x":7700,"y":1700,"width":1080,"height":330,"text":"## 2主体\n创作者／个人、专业、公众、机构认可主体／资本平台\n不同认可层级不得合并","color":"3"},
		{"id":"B33","type":"text","x":8900,"y":1700,"width":1080,"height":330,"text":"## 3关系\n权限：发布/署名/推荐/引见\n认可：谁认可什么、为何重要、采用范围与阶段","color":"3"},
		{"id":"B34","type":"text","x":5300,"y":2130,"width":1080,"height":330,"text":"## 4触发\n作品发布/舆论危机/竞争舞台\n回填呈现对象、目标认可主体、回应与代价","color":"3"},
		{"id":"B35","type":"text","x":6500,"y":2130,"width":1080,"height":330,"text":"## 5状态\n未进入目标认可位置→可识别形式与归因接口→确认/误认/拒绝→渠道与认可分别结算","color":"2"},
		{"id":"B36","type":"text","x":7700,"y":2130,"width":1080,"height":330,"text":"## 6端点\nx并z：作品/人设壳\nz：具体确认\nzx：公开扩权另判\nx：渠道署名入口","color":"5"},
		{"id":"B37","type":"text","x":8900,"y":2130,"width":1080,"height":330,"text":"## 7生克补\n已锁定候选：x并z生z/x生x并z/x克z\n曝光/播放量/热搜≠z","color":"5"},
		{"id":"B38","type":"text","x":5300,"y":2560,"width":1080,"height":330,"text":"## 8动态链\nx并z作品壳→【进入特定认可位置】→z确认\n渠道控制则开x克z分支\n公开扩权另开zx分支","color":"5"},
		{"id":"B39","type":"text","x":6500,"y":2560,"width":1080,"height":330,"text":"## 9主题\n暂不升格\n长期训练+专业确认可转时间候选","color":"3"},
		{"id":"B3a","type":"text","x":7700,"y":2560,"width":1080,"height":330,"text":"## 10反证\n流量≠z，大众看见≠正确归因\n拿掉目标认可主体后检查x/xn/zx","color":"2"},
		{"id":"B3b","type":"text","x":8900,"y":2560,"width":1080,"height":330,"text":"## 11输出\n认可分账卡/作品壳卡/渠道控制卡/署名归因卡/分支链/反证卡","color":"2"},
		{"id":"B4g","type":"group","x":0,"y":3200,"width":5000,"height":1450,"label":"T-B05｜商战创业｜12节点｜跨区骨架候选","color":"5"},
		{"id":"B40","type":"text","x":100,"y":3300,"width":1080,"height":330,"text":"## 0入口\n初始候选主xn｜辅zx/x/n\n职业经营机制须H区复核","color":"4"},
		{"id":"B41","type":"text","x":1300,"y":3300,"width":1080,"height":330,"text":"## 1对象\n主：主动组织并持续运行的产品/流程/市场结构\n关联：资金/承载/产权/渠道/市场入口","color":"3"},
		{"id":"B42","type":"text","x":2500,"y":3300,"width":1080,"height":330,"text":"## 2主体\n创业者／团队／投资人与竞争者／市场采用主体\n组织、承载、控制、显权分开","color":"3"},
		{"id":"B43","type":"text","x":3700,"y":3300,"width":1080,"height":330,"text":"## 3关系\n谁组织流程、掌握产权、承担负荷、公开处置、确认采用","color":"3"},
		{"id":"B44","type":"text","x":100,"y":3730,"width":1080,"height":330,"text":"## 4触发\n机会窗口/资金危机/产品失败\n回填行动、回应、收益、代价与替代路径","color":"3"},
		{"id":"B45","type":"text","x":1300,"y":3730,"width":1080,"height":330,"text":"## 5状态\n零散行动→主动组织→结构持续/失败→采用、产权、权能分别结算","color":"2"},
		{"id":"B46","type":"text","x":2500,"y":3730,"width":1080,"height":330,"text":"## 6端点\nxn主动组织｜x产权渠道｜zx公开处置｜n真实承载\n团队存在不自动n","color":"5"},
		{"id":"B47","type":"text","x":3700,"y":3730,"width":1080,"height":330,"text":"## 7生克补\nxn克zx/zx克n按变量调用\nn生xn不得默认：须先n承载，再因重复负荷流程化","color":"5"},
		{"id":"B48","type":"text","x":100,"y":4160,"width":1080,"height":330,"text":"## 8动态链\n零散→【主动组织】xn→分支x/n/zx→仅当n重复负荷迫使流程化，建立n生xn回路→持续/崩解","color":"5"},
		{"id":"B49","type":"text","x":1300,"y":4160,"width":1080,"height":330,"text":"## 9主题\n暂不升格\n职业现实主导则转H区","color":"3"},
		{"id":"B4a","type":"text","x":2500,"y":4160,"width":1080,"height":330,"text":"## 10反证\n忙碌/加班/融资/营收/执行制度≠xn\n被动沿投资人方向可能是nx","color":"2"},
