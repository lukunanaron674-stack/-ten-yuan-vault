			"y":-328,
			"width":275,
			"height":93
		},
		{
			"id":"8d8c454b8ab973d4",
			"type":"text",
			"text":"背景台词配合画面，",
			"styleAttributes":{},
			"x":221,
			"y":-404,
			"width":260,
			"height":60
		},
		{
			"id":"82cdd6069e7cc1a0",
			"type":"text",
			"text":"第一幕",
			"styleAttributes":{},
			"x":200,
			"y":-514,
			"width":260,
			"height":60
		},
		{
			"id":"3a8ce31834deada1",
