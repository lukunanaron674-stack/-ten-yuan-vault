      "file": "02_给我用的知识凝结库/01_动态链条/电影卡/C17_星际穿越.md"
    },
    {
      "id": "TENCHAIN_UNIFIED_CENTER",
      "type": "group",
      "label": "统一入口｜十元链｜中心只读导航",
      "x": -1150,
