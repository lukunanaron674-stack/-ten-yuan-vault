{"nodes":[{"id":"root","type":"text","text":"🐉 东方机械幻想\n鬼角武装少女 × 机械龙蛇外置兵装\nxn+zx 核心｜xz+zn 风味","x":0,"y":-980,"width":520,"height":110,"color":"1"},{"id":"def","type":"text","text":"📖 核心定义\n以和风鬼角少女为柔软的人形核心，\n将机械龙蛇、刀剑与模块化兵装组合成第二身体。","x":20,"y":-830,"width":480,"height":115,"color":"6"},{"id":"notcyber","type":"text","text":"⚠️ 误判校正\n不是标准赛博朋克：缺少高科技低生活、企业压迫、霓虹都市等社会语境。\n不是传统驾驶机甲：机械更像伴生兽与外置身体。","x":560,"y":-830,"width":430,"height":130,"color":"5"},{"id":"ref","type":"text","text":"🖼️ 本次参考图\n黑发红眼鬼角少女\n白衣、高跟、日式刀\n灰黑机械龙蛇、红带、青色能源槽","x":-480,"y":-830,"width":390,"height":130,"color":"4"},{"id":"concept_h","type":"text","text":"① 概念结构","x":-820,"y":-610,"width":300,"height":65,"color":"1"},{"id":"human","type":"text","text":"人物母体\n鬼角武装少女\n自然人形＋东方异族意象","x":-980,"y":-500,"width":280,"height":95,"color":"6"},{"id":"machine","type":"text","text":"机械母体\n机械龙／机械蛇／节肢战斗平台\n坐骑＋兵器＋伴生兽","x":-660,"y":-500,"width":300,"height":110,"color":"6"},{"id":"relation","type":"text","text":"关系核心\n机器不是旁边的道具\n而是角色的第二身体","x":-820,"y":-350,"width":300,"height":95,"color":"2"},{"id":"functions","type":"text","text":"四重功能\n骑乘｜护卫｜攻击｜身份图腾","x":-820,"y":-220,"width":300,"height":75,"color":"3"},{"id":"genre_h","type":"text","text":"② 题材／世界观","x":-300,"y":-610,"width":330,"height":65,"color":"1"},{"id":"genre_top","type":"text","text":"上位题材\n科幻奇幻混合","x":-430,"y":-500,"width":250,"height":80,"color":"6"},{"id":"genre_main","type":"text","text":"主要题材\n东方机械幻想／和风机甲","x":-150,"y":-500,"width":280,"height":80,"color":"6"},{"id":"culture","type":"text","text":"文化风味\n鬼族｜武士刀｜红绳｜刀鞘","x":-430,"y":-380,"width":250,"height":90,"color":"4"},{"id":"tech","type":"text","text":"科技方向\n模块化关节｜外骨骼｜能源核心｜硬表面装甲","x":-150,"y":-380,"width":280,"height":100,"color":"4"},{"id":"role_type","type":"text","text":"角色类型\n武装少女｜机械伴生体｜舰装式构成","x":-300,"y":-240,"width":300,"height":90,"color":"3"},{"id":"style_h","type":"text","text":"③ 视觉风格","x":240,"y":-610,"width":330,"height":65,"color":"1"},{"id":"style_main","type":"text","text":"大类\n日系二次元游戏角色设定图\n赛璐璐人物＋硬表面机械","x":180,"y":-500,"width":300,"height":105,"color":"6"},{"id":"person_style","type":"text","text":"人物画法\n清晰线稿｜低密度色块｜二分至三分明暗\n柔和发丝渐变","x":120,"y":-350,"width":280,"height":105,"color":"4"},{"id":"mech_style","type":"text","text":"机械画法\n高密度装甲切面｜转轴｜机械缝｜能源槽\n信息量明显高于人物","x":430,"y":-350,"width":300,"height":105,"color":"4"},{"id":"shape","type":"text","text":"造型语言\n尖角｜三角｜后掠翼｜刀刃｜分节尾\n锐利、速度、猎食者型","x":270,"y":-200,"width":330,"height":100,"color":"2"},{"id":"visual_h","type":"text","text":"④ 构图与色彩","x":760,"y":-610,"width":330,"height":65,"color":"1"},{"id":"density","type":"text","text":"密度关系\n低密度少女 × 高密度机械","x":760,"y":-500,"width":300,"height":80,"color":"6"},{"id":"direction","type":"text","text":"方向关系\n少女：竖直静态\n机械：横向延伸与攻击轮廓","x":760,"y":-385,"width":300,"height":95,"color":"4"},{"id":"palette","type":"text","text":"配色结构\n黑灰白无彩底\n红色主强调｜青色微量科技点缀｜少量铜色关节","x":760,"y":-250,"width":330,"height":110,"color":"3"},{"id":"effect","type":"text","text":"视觉效果\n优雅、精密、危险、冷静\n危险由结构储备而非动作表现","x":760,"y":-100,"width":330,"height":100,"color":"2"},{"id":"ten_h","type":"text","text":"⑤ 十元结构","x":-650,"y":40,"width":340,"height":65,"color":"1"},{"id":"xn","type":"text","text":"xn 8／10\n机械规则、模块、关节、能源、结构秩序","x":-820,"y":150,"width":270,"height":95,"color":"6"},{"id":"zx","type":"text","text":"zx 7／10\n刀、尾刃、战斗平台、执行功能","x":-520,"y":150,"width":270,"height":95,"color":"6"},{"id":"xz","type":"text","text":"xz 6／10\n鬼角、异形机械兽、不可能组合","x":-820,"y":280,"width":270,"height":95,"color":"5"},{"id":"zn","type":"text","text":"zn 4／10\n和风身份、刀剑文化、红绳纹样","x":-520,"y":280,"width":270,"height":95,"color":"4"},{"id":"x","type":"text","text":"x 3／10\n力量欲望潜伏，但尚无腐化叙事","x":-670,"y":410,"width":270,"height":90,"color":"3"},{"id":"ten_formula","type":"text","text":"核心公式\nxn＋zx 为骨架\nxz＋zn 提供世界观风味","x":-670,"y":535,"width":300,"height":95,"color":"2"},{"id":"dynamic","type":"text","text":"关系判断\n技术规则被武器化：xn 生／补 zx\n异族不可能性 xz 被东方身份 zn 稳定\n角色通过外置兵装扩大身体边界","x":-680,"y":670,"width":360,"height":135,"color":"1"},{"id":"axes_h","type":"text","text":"⑥ 五轴归档","x":-150,"y":40,"width":340,"height":65,"color":"1"},{"id":"axis1","type":"text","text":"对象母体\n鬼角武装少女／机械龙蛇伴生体","x":-230,"y":150,"width":280,"height":85,"color":"6"},{"id":"axis2","type":"text","text":"题材世界观\n东方机械幻想／和风科幻奇幻","x":80,"y":150,"width":280,"height":85,"color":"6"},{"id":"axis3","type":"text","text":"状态时间\n待机态／装备展示态／未进入战斗","x":-230,"y":270,"width":280,"height":85,"color":"4"},{"id":"axis4","type":"text","text":"功能用途\n战斗／骑乘／护卫／角色登场","x":80,"y":270,"width":280,"height":85,"color":"4"},{"id":"axis5","type":"text","text":"氛围情绪\n冷静／危险／精密／疏离／优雅","x":-70,"y":390,"width":290,"height":90,"color":"2"},{"id":"theme_h","type":"text","text":"⑦ 概念表达","x":330,"y":40,"width":340,"height":65,"color":"1"},{"id":"theme1","type":"text","text":"柔软身体 × 坚硬机器\n脆弱本体拥有超出身体尺度的力量","x":250,"y":150,"width":300,"height":95,"color":"6"},{"id":"theme2","type":"text","text":"古代刀剑 × 未来机械\n过去的身份符号被未来技术重新武装","x":580,"y":150,"width":310,"height":95,"color":"6"},{"id":"theme3","type":"text","text":"人与机械兽边界模糊\n不是驾驶，而是第二身体","x":250,"y":285,"width":300,"height":90,"color":"4"},{"id":"theme4","type":"text","text":"优雅 × 危险\n静止姿态中储备攻击性","x":580,"y":285,"width":310,"height":90,"color":"4"},{"id":"theme_core","type":"text","text":"主题核心\n身体边界扩张｜传统身份技术化｜力量外置化","x":410,"y":420,"width":350,"height":95,"color":"2"},{"id":"ext_h","type":"text","text":"⑧ 创作扩展","x":850,"y":40,"width":340,"height":65,"color":"1"},{"id":"scene1","type":"text","text":"登场场景\n白雾平台／神社机库／雪地维修场\n角色静止，机械尾先行展开","x":800,"y":150,"width":330,"height":105,"color":"6"},{"id":"scene2","type":"text","text":"战斗场景\n机械龙蛇绕体护卫\n刀与尾刃形成双层攻击半径","x":800,"y":290,"width":330,"height":100,"color":"4"},{"id":"scene3","type":"text","text":"叙事方向\n机械是家族遗物、契约兽或封印兵装\n损坏机械等于身体受伤","x":800,"y":425,"width":330,"height":110,"color":"4"},{"id":"tags","type":"text","text":"推荐标签\n东方机械幻想｜和风机甲｜武装少女｜鬼角少女\n机械龙｜机械蛇｜外置兵装｜舰装式构成\n刀剑科技融合｜硬表面机械｜黑灰红配色","x":800,"y":570,"width":370,"height":155,"color":"3"},{"id":"archive","type":"t