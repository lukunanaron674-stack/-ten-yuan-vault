    "CHAT_NEEDS_CANONICAL_SYMBOL",
    "CHAT_NO_ACTIVE_SESSION",
    "CHAT_UNKNOWN_MODULE",
    "CHAT_MULTI_RESPONSIBILITY_REQUIRED",
