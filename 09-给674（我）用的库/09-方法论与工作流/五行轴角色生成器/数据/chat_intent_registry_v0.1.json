    "set_multi_mode": ["多符号", "双符号", "组合模式", "multi模式"],
    "inspect_reasoning": ["为什么", "解释结构", "给我中间链", "看映射链", "为什么这样生成"],
    "reject_concrete": ["这个名词不要", "这个载体不要", "换个具象", "这个具体东西不要"]
