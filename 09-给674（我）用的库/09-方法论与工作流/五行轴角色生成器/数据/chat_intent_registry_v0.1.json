    "surface_only_examples": ["可爱", "红色", "骑士", "贫穷", "高贵", "偶像", "忧郁", "阳光"]
  },
  "session_state_schema": {
    "active_raw_trigger": null,
    "active_subject": null,
    "canonical_symbols": [],
    "mode": null,
    "genre_context": "default",
    "seed": "74",
    "nonce": 0,
    "locked_modules": [],
    "last_output": null,
    "roles": null,
    "parser_version": null,
    "mapping_version": null
