{
  "schema_version": "v0.1",
  "purpose": "chat-natural-language-to-generator-control",
  "canonical_source": "数据/trigger_registry_v0.1.json",
  "rules": {
    "chat_must_not_define_symbol_from_surface_words": true,
    "reuse_active_symbols_only_when_session_state_exists": true,
    "multi_requires_explicit_responsibility_source": true,
    "graph_forbids_vector_weights": true,
    "not_implemented_must_remain_explicit": true,
    "fail_closed": true
  },
  "intents": {
    "generate_new": ["来个", "生成", "做一个", "给我一个", "新建", "重新生成一个"],
    "continue_current": ["继续这个", "沿用这个", "按这个继续", "上一版继续", "保持这个"],
    "lock_modules": ["锁", "锁定", "别动", "保持不变", "这个不动"],
    "reroll_modules": ["重抽", "只换", "换掉", "再抽", "只改", "重新抽"],
    "set_graph_mode": ["无向量", "无向量尺标", "图模式", "关系图模式", "graph模式"],
