    "身份/行为": ["身份", "职业", "工作", "行为", "动作"],
    "关系": ["关系", "恋爱", "朋友", "家庭关系", "社会关系"],
    "一生": ["一生", "人生", "生命周期", "成长", "结局"],
    "构图": ["构图", "空间", "画面", "镜头布局"],
    "具象名词": ["具象名词", "名词", "具体物", "载体"]
