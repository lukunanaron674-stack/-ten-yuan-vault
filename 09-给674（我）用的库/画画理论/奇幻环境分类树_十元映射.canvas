		{"id":"env_main","type":"text","text":"🏞️ 环境概念设计\nn+xn 五维分类 [[🏞️ 环境概念设计 n+xn 空间承载+规则/环境概念设计_五维分类.canvas]]","x":800,"y":280,"width":180,"height":80,"color":"4"},
		{"id":"concept_关键帧/海报","type":"text","text":"🌌 关键帧/海报\nzn+ALL\n一帧即世界","x":1010,"y":160,"width":200,"height":75,"color":"3"},
		{"id":"env_幻想/异界","type":"text","text":"🗺️ ②题材/风格","x":1130,"y":370,"width":140,"height":55,"color":"5"},
