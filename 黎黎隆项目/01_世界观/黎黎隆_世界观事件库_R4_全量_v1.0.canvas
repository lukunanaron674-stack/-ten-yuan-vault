{
	"nodes":[
		{"id":"G_R3","type":"group","x":0,"y":7680,"width":5030,"height":1260,"color":"#8B5CF6","label":"03｜R3 候选世界规则：先候选，别急着封神"},
		{"id":"G_R2","type":"group","x":0,"y":6400,"width":5030,"height":1160,"color":"#0F8B8D","label":"02｜R2 聚类：从120条事件里找反复出现的世界母题"},
		{"id":"G_R4_SUM","type":"group","x":0,"y":9060,"width":5030,"height":980,"color":"#475569","label":"04｜R4 收束：120条 → 核心种子 → 回写闸门"},
		{"id":"G_B1","type":"group","x":0,"y":1160,"width":1600,"height":2440,"color":"#43A86B","label":"🟩 奇幻仍在活着｜20条"},
		{"id":"G_B2","type":"group","x":1710,"y":1160,"width":1600,"height":2440,"color":"#3B82F6","label":"🟦 技术正在接管｜20条"},
		{"id":"G_B3","type":"group","x":3420,"y":1160,"width":1600,"height":2440,"color":"#E25555","label":"🟥 毁灭留下裂口｜20条"},
		{"id":"G_B4","type":"group","x":0,"y":3720,"width":1600,"height":2440,"color":"#D5A437","label":"🟨 普通人的日常｜20条"},
		{"id":"G_B5","type":"group","x":1710,"y":3720,"width":1600,"height":2440,"color":"#9166D8","label":"🟪 人与异常相遇｜20条"},
