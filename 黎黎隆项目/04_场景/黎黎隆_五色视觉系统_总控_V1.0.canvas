		{"id":"r5-08-result","type":"file","file":"黎黎隆项目/04_场景/五色视觉系统/R5_十元盲测/assets/R5-08_XN路径约束_对照.png","x":3920,"y":4850,"width":600,"height":338,"color":"#69D4CE"},
