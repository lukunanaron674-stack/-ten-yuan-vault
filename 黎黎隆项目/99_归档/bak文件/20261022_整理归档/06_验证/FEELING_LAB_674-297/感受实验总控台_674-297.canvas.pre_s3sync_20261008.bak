      "width": 650,
      "height": 258,
      "color": "3"
    },
    {
      "id": "fc0ff54e70294490",
      "type": "file",
      "file": "黎黎隆项目/03_角色/角色库/10_角色仓库/03_审核数据/173/173-04_红心角色十元审核台_STAGING_20261008.canvas",
      "x": 2680,
