{
  "schema_version": "1.2",
  "production_policy": "ASSET_FIRST_LONGTAKE",
  "rules": [
    {
      "when": {
        "shot_status": "IDLE",
        "director_mode": "PRODUCTION"
      },
      "route": "DIRECTOR_INIT",
      "agent": "director"
    },
    {
      "when": {
        "director_mode": "PRODUCTION",
        "shot_status": "PLANNING",
        "asset_status": "UNCHECKED"
      },
      "route": "ASSET_AUDIT",
      "agent": "asset"
    },
    {
      "when": {
        "asset_status": "MISSING",
        "auto_asset_generation_allowed": true
      },
      "route": "IMAGE_GENERATE",
      "agent": "image"
    },
    {
      "when": {
        "asset_status": "MISSING",
        "auto_asset_generation_allowed": false
      },
      "route": "BLOCK",
      "agent": "director"
    },
    {
      "when": {
        "asset_status": "PENDING_REVIEW"
      },
      "route": "STYLE_REVIEW",
      "agent": "style_review"
    },
    {
      "when": {
        "director_mode": "PRODUCTION",
        "shot_status": "PLANNING",
        "asset_status": "READY"
      },
      "route": "THEME_PLAN_FROM_ASSETS",
      "agent": "theme"
    },
    {
      "when": {
        "shot_status": "THEME_READY",
        "world_gate": "REQUIRED"
      },
      "route": "WORLD_CHECK",
      "agent": "world"
    },
    {
      "when": {
        "shot_status": "THEME_READY",
        "world_gate": "BYPASS"
      },
      "route": "SCRIPT_PROPOSAL_FROM_ASSETS",
      "agent": "script"
    },
    {
      "when": {
        "shot_status": "WORLD_READY"
      },
      "route": "SCRIPT_PROPOSAL_FROM_ASSETS",
      "agent": "script"
    },
    {
      "when": {
        "shot_status": "SCRIPT_READY"
      },
      "route": "TENYUAN_REVIEW",
      "agent": "tenyuan"
    },
    {
      "when": {
        "shot_status": "TENYUAN_READY"
      },
      "route": "STORYBOARD_BUILD_LONGTAKE",
      "agent": "storyboard"
    },
    {
      "when": {
        "shot_status": "STORYBOARD_READY",
        "asset_recheck": "REQUIRED"
      },
      "route": "ASSET_RECHECK",
      "agent": "asset"
    },
    {
      "when": {
        "shot_status": "STORYBOARD_READY",
        "asset_status": "READY",
        "asset_recheck": "PASS",
        "render_status": "NOT_STARTED",
        "h3_mode": "LONGTAKE"
      },
      "route": "LONGTAKE_RENDER_DISPATCH",
      "agent": "h3"
    },
    {
      "when": {
        "render_status": "QUEUED",
        "executor_receipt": null
      },
      "route": "WAIT_EXECUTOR",
      "agent": null,
      "no_op": true
    },
    {
      "when": {
        "render_status": "RENDERING"
      },
      "route": "WAIT_RENDER",
      "agent": null,
      "no_op": true
    },
    {
      "when": {
        "render_status": "SUCCESS"
      },
      "route": "VIDEO_REVIEW",
      "agent": "video_review"
    },
    {
      "when": {
        "review_decision": "PASS"
      },
      "route": "MERGE_PASS_AND_NEXT_LONGTAKE",
      "agent": "director"
    },
    {
      "when": {
        "review_decision": "RETRY"
      },
      "route": "RETRY_ROUTE",
      "agent": "director"
    },
    {
      "when": {
        "review_decision": "REPLAN"
      },
      "route": "REPLAN_ROUTE",
      "agent": "director"
    },
    {
      "when": {
        "shot_status": "BLOCKED"
      },
      "route": "BLOCKER_OWNER",
      "agent": "director"
    },
    {
      "when": {
        "director_mode": "NONE",
        "learning_enabled": true
      },
      "route": "LEARNING_ROUTER",
      "agent": "director"
    },
    {
      "when": {
        "state_changed": false
      },
      "route": "NO_OP",
      "agent": null,
      "no_op": true
    }
  ],
  "throttle": {
    "max_primary_agents_per_tick": null,
    "max_dependent_agents_per_tick": 1,
    "max_discussion_rounds": 3,
    "same_state_hash_no_op": true,
    "unchanged_blocker_no_repeat": true,
    "sequential_only": true,
    "stop_at_external_blocker": true
  },
  "dispatch_mode": "RUN_UNTIL_EXTERNAL_BLOCKER",
  "macro_chain": [
    "ASSET_AUDIT",
    "STYLE_REVIEW",
    "THEME_PLAN_FROM_ASSETS",
    "SCRIPT_PROPOSAL_FROM_ASSETS",
    "TENYUAN_REVIEW",
    "STORYBOARD_BUILD_LONGTAKE",
    "ASSET_RECHECK",
    "LONGTAKE_RENDER_DISPATCH"
  ],
  "stop_conditions": [
    "EXTERNAL_ASSET_GENERATION",
    "WAIT_EXECUTOR_RECEIPT",
    "WAIT_RENDER",
    "CANON_CONFLICT",
    "REPLAN",
    "USER_DECISION_REQUIRED",
    "RETRY_LIMIT_EXCEEDED"
  ]
}