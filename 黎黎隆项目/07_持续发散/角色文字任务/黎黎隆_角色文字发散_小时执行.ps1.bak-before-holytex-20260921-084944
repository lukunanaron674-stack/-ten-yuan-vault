        defaults=[ordered]@{w=1280;h=736;len=240;steps=8;seed=0;note='candidate only; formal character charm experiment; human review required'}
        tasks=@([ordered]@{card=$RunId;prompt_md=$promptMd;workflow=$CloudWorkflow;prefix=$prefix;w=1280;h=736;len=240;steps=8;seed=0;note='01-03 microstory; scene reference is environment only; role image is absent unless explicitly verified';ref=($refs -join ',')})
    }
    Save-Json $specPath $spec
    $checkLog=Join-Path $RunDir 'h3-4090d-check.log'
    $check=Invoke-4090DChannel -ChannelArgs @('check','--spec',$specPath) -LogPath $checkLog
    # check-only 模式下，h3_4090d_channel.py 的退出码 0 即代表 preflight 通过
    # （它内部已用真实回显判过，失败会 return 1）。
    # 不要再拿中文字符串去 match —— 经 Windows 控制台编码层后中文会变乱码，
    # 导致「实际全绿却被判 FAILED」（2026-09-21 踩过）。
    if($check.exit_code -ne 0) {Update-ExperimentForH3 'BLOCKED_4090D_PREFLIGHT_FAILED' '' $null "check exit_code=$($check.exit_code); see $checkLog";return [pscustomobject]@{status='BLOCKED_4090D_PREFLIGHT_FAILED';video_path='';probe=$null;task_id=''}}
    $submitLog=Join-Path $RunDir 'h3-4090d-submit.log'
    $submit=Invoke-4090DChannel -ChannelArgs @('submit','--spec',$specPath) -LogPath $submitLog
    $taskId='';$m=[regex]::Match($submit.output,'(?m)\[OK\] 入池\s+([^\s|]+)');if($m.Success){$taskId=$m.Groups[1].Value}
    # 同理：submit 的成败看退出码（channel 内部已用真实回显判过，未确认写入会 return 1），
    # 别 match 中文 '已写入 pending'——编码层会把它变成乱码导致误判 FAILED。
    if($submit.exit_code -ne 0){Update-ExperimentForH3 'FAILED_4090D_SUBMIT' '' $null "submit exit_code=$($submit.exit_code); see $submitLog";return [pscustomobject]@{status='FAILED_4090D_SUBMIT';video_path='';probe=$null;task_id=$taskId}}
    $result=[ordered]@{status='已入队_待4090D生产';video_path='';probe=$null;task_id=$taskId;remote_prefix=$prefix;spec=$specPath;check_log=$checkLog;submit_log=$submitLog;input_mode=$(if($roleImage -and (Test-Path -LiteralPath $roleImage)){'Ref2VA_role_plus_scene'}else{'Ref2VA_scene_environment_only_role_text_locked'});reason='queued through Hermes channel; actual MP4, remote/local probe and human review still pending'}
    Update-ExperimentForH3 '已入队_待4090D生产' '' $null 'check passed and task was written to remote pending; no MP4 claim'
    $obj=Read-JsonFile (Join-Path $RunDir 'experiment.json');if($null -ne $obj){$obj.h3=$result;Save-Json (Join-Path $RunDir 'experiment.json') $obj}
    Write-RunLog "H3_4090D_SUBMITTED | task_id=$taskId | prefix=$prefix"
    return [pscustomobject]$result
}

if(-not (Acquire-RunLock)){exit 0}
try {
    Write-RunLog "RUN_START | scheduled=$Scheduled | manual=$Manual | dry_run=$DryRun | run_id=$RunId"
    $state=Get-State; $source=Get-SourceSnapshot; $inventory=Get-AssetInventory
    Save-Json (Join-Path $RunDir 'preflight-source.json') $source; Save-Json (Join-Path $RunDir 'preflight-assets.json') $inventory
    $experiment=$null; $activeRunDir=[string]$state.pending_run_dir
    if($activeRunDir -and (Test-Path -LiteralPath (Join-Path $activeRunDir 'experiment.json'))){$experiment=Read-JsonFile (Join-Path $activeRunDir 'experiment.json');$resumeId=[string](Get-PropertyValue (Get-PropertyValue $experiment 'character' $null) 'id' '');if($null -ne $experiment -and $resumeId -and $resumeId -ne 'unknown'){Write-RunLog "RESUME_PENDING_EXPERIMENT | pending=$activeRunDir";$RunDir=$activeRunDir}else{$experiment=$null;Write-RunLog 'DISCARD_INVALID_PENDING_EXPERIMENT | missing character id'}}
    if($null -eq $experiment){
        $cards=@($inventory.role_cards);if($cards.Count -eq 0){throw 'NO_ROLE_CARDS_FOUND'}
        $roleIndex=[int]$state.next_index % $cards.Count; $generationPrompt=Build-GenerationPrompt -Source $source -Inventory $inventory -RoleIndex $roleIndex -PreviousState $state
        try {
            if($FallbackOnly){throw 'FALLBACK_ONLY_REQUESTED'}
            $experiment=Invoke-CodexGeneration -Prompt $generationPrompt -Phase 'experiment_generation'
            Assert-Experiment $experiment
            Write-RunLog 'GENERATION_METHOD | codex_exec_json'
        } catch {
            # 计划任务不能因嵌套 Codex 的环境策略、网络或编码问题丢掉本轮实验。
            # 回退卡只使用角色卡中已确认身份/造型，所有关系都保持“待判定/候选”。
            Write-RunLog ("CODEX_FALLBACK | " + $_.Exception.Message)
            $experiment=New-FallbackExperiment -Inventory $inventory -Source $source -RoleIndex $roleIndex -PreviousState $state
            Assert-Experiment $experiment
            Write-RunLog 'GENERATION_METHOD | deterministic_safe_fallback'
        }
        Write-ExperimentFiles -Experiment $experiment -Source $source -Inventory $inventory
        Save-State ([ordered]@{next_index=(($roleIndex+1)%$cards.Count);last_run=(Get-Date).ToString('o');last_card=[string]$experiment.character.id;mode='formal_character_charm_experiment';pending_run_dir=$RunDir})
        Write-RunLog "EXPERIMENT_WRITTEN | character=$($experiment.character.id) | shots=8 | pending=$RunDir"
    }
    $h3=Invoke-H3Microstory -Experiment $experiment; $finalState=Get-State
    $finalState.last_run=(Get-Date).ToString('o');$finalState.last_card=[string]$experiment.character.id
    if($h3.status -eq '已生成_待人工验收'){$finalState.pending_run_dir=''}else{$finalState.pending_run_dir=$RunDir};Save-State $finalState
    $runSummary=[ordered]@{action_id=$RunId;status=$h3.status;run_dir=$RunDir;experiment_id=[string]$experiment.experiment_id;character_id=[string]$experiment.character.id;character_name=[string]$experiment.character.name;shots_written=@($experiment.shots).Count;h3_video=[string](Get-PropertyValue $h3 'video_path' '');h3_probe=(Get-PropertyValue $h3 'probe' $null);h3_task_id=[string](Get-PropertyValue $h3 'task_id' '');h3=$h3;source_head=$source.head;source_origin_main=$source.origin_main;original_role_or_scene_assets_modified=$false;formal_canvas_modified=$false;theory_canon_modified=$false;human_review='REQUIRED'}
    Save-Json (Join-Path $RunDir 'run-summary.json') $runSummary
    Publish-HermesResult -Status ([string]$h3.status) -RunDirectory $RunDir -Experiment $experiment -H3 $h3 -Source $source
    if(-not (Test-Path -LiteralPath $LogPath)){@('# 黎黎隆十元角色魅力实验｜小时记录','','- 每轮 8 条 H3 描述词；01–03 合成约 10 秒微故事。','- 输出均为候选；视频需人工验收后才可锁定。','')|Set-Content -LiteralPath $LogPath -Encoding UTF8}
    $logVideo=[string](Get-PropertyValue $h3 'video_path' '')
    $logTask=[string](Get-PropertyValue $h3 'task_id' '')
    $logBlock=@("## $RunId｜$((Get-Date).ToString('yyyy-MM-dd HH:mm:ss zzz'))｜$($experiment.character.name)",'',"- 角色卡：$($experiment.character.card_path)","- 关系假设：$($experiment.relation_hypothesis.relation_type)；$($experiment.relation_hypothesis.source_endpoint) → $($experiment.relation_hypothesis.target_endpoint)","- 被改变变量：$($experiment.relation_hypothesis.changed_variable)","- 写入 8 条描述词：$RunDir","- H3：$($h3.status)",$(if($logTask){"- Hermes/4090D task_id：$logTask"}else{'- Hermes/4090D task_id：无'}),$(if($logVideo){"- MP4：$logVideo"}else{'- MP4：未回收；入队不等于出片。'}),'- 原角色卡、正式 Canvas、十元理论正本：未修改。','- 人工验收：必需；不能从描述词或 MP4 存在直接推出魅力假设已验证。','') -join "`n"
    Add-Content -LiteralPath $LogPath -Value $logBlock -Encoding UTF8
    Write-Output ("RUN_OK action_id={0} character={1} h3={2} run_dir={3}" -f $RunId,$experiment.character.id,$h3.status,$RunDir)
    if($h3.status -like 'FAILED*'){exit 20};exit 0
} catch {
    $message=$_.Exception.Message;Write-RunLog "FAIL | $message"
    try{Save-Json (Join-Path $RunDir 'run-summary.json') ([ordered]@{action_id=$RunId;status='FAIL';blocker=$message;originals_modified=$false;formal_canvas_modified=$false;theory_canon_modified=$false})}catch{}
    Write-Error $message;exit 99
} finally { Release-RunLock }


