function Assert-Experiment {
    param([object]$Experiment)
    if ($null -eq $Experiment) { throw 'EXPERIMENT_NULL' }
    if (@($Experiment.shots).Count -ne 8) { throw "EXPERIMENT_SHOT_COUNT_INVALID: $(@($Experiment.shots).Count)" }
    $ids = @($Experiment.shots | ForEach-Object { [string]$_.id })
    if (($ids -join ',') -ne '01,02,03,04,05,06,07,08') { throw "EXPERIMENT_SHOT_IDS_INVALID: $($ids -join ',')" }
    if ([string]::IsNullOrWhiteSpace([string]$Experiment.microstory_prompt)) { throw 'EXPERIMENT_MICROSTORY_PROMPT_EMPTY' }
    foreach ($shot in @($Experiment.shots)) { if ([string]::IsNullOrWhiteSpace([string]$shot.h3_prompt)) { throw "EXPERIMENT_SHOT_PROMPT_EMPTY: $($shot.id)" } }
}

