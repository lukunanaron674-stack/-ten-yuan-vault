function Poll-4090DTask {
    param([object]$Experiment)
    $oldH3=Get-PropertyValue $Experiment 'h3' $null
    $taskId=[string](Get-PropertyValue $oldH3 'task_id' '')
    if(-not $taskId){return $null}
    $resultLog=Join-Path $RunDir 'h3-4090d-result.log'
    $poll=Invoke-4090DChannel -ChannelArgs @('result','--task-id',$taskId) -LogPath $resultLog
    $snapshot=Convert-LastJsonLine $poll.output
    if(-not $snapshot){return [pscustomobject]@{status='已入队_待4090D生产';task_id=$taskId;video_path='';probe=$null;reason='result poll returned no JSON; see result log';poll_log=$resultLog}}
    $remoteStatus=[string](Get-PropertyValue (Get-PropertyValue $snapshot 'status' $null) 'status' 'unknown')
    $remoteFiles=@(Get-PropertyValue $snapshot 'remote_files' @())
    if($remoteStatus -eq 'done' -and $remoteFiles.Count -gt 0){
        $collectLog=Join-Path $RunDir 'h3-4090d-collect.log'
        $collect=Invoke-4090DChannel -ChannelArgs @('collect','--task-id',$taskId,'--out-dir',$H3DeliveryRoot) -LogPath $collectLog
        $collected=Convert-LastJsonLine $collect.output
        $videoPath=[string](Get-PropertyValue $collected 'local_file' '')
        if($collect.exit_code -eq 0 -and $videoPath -and (Test-Path -LiteralPath $videoPath)){
            $probe=Get-LocalVideoProbe $videoPath;Save-Json (Join-Path $RunDir 'h3-postflight.json') $probe
            return [pscustomobject]@{status='已生成_待人工验收';task_id=$taskId;video_path=$videoPath;probe=$probe;remote_result=$snapshot;collect=$collected;reason='remote task done; local MP4 collected and probed; visual review pending'}
        }
        return [pscustomobject]@{status='FAILED_4090D_COLLECT';task_id=$taskId;video_path='';probe=$null;remote_result=$snapshot;reason='remote task done but local collection failed; see collect log'}
    }
    if($remoteStatus -in @('failed','error')){return [pscustomobject]@{status='FAILED_4090D_REMOTE';task_id=$taskId;video_path='';probe=$null;remote_result=$snapshot;reason='remote pool status failed; no automatic retry'}}
    return [pscustomobject]@{status='已入队_待4090D生产';task_id=$taskId;video_path='';probe=$null;remote_result=$snapshot;reason="remote task status=$remoteStatus; no MP4 claim"}
}

