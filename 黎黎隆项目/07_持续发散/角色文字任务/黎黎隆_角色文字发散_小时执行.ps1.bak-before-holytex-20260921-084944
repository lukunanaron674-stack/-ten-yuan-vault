function Invoke-CodexGeneration {
    param([Parameter(Mandatory=$true)][string]$Prompt, [Parameter(Mandatory=$true)][string]$Phase)
    if (-not (Test-Path -LiteralPath $CodexExe)) { throw "CODEX_NOT_FOUND: $CodexExe" }
    $eventPath = Join-Path $RunDir "$Phase.events.jsonl"
    $lastPath = Join-Path $RunDir "$Phase.last.txt"
    $env:CODEX_HOME = $CodexHomePath
    # Windows PowerShell 5.1 的 native argument marshalling 会把 JSON 内的
    # 引号拆成多个 argv；把长提示词经 stdin 交给 `codex exec -`，避免该问题。
    $args = @('exec','--ephemeral','--ignore-user-config','--json','--skip-git-repo-check','--disable','apps','-C',$WorkspaceRoot,'--add-dir',$VaultRoot,'--sandbox','read-only','-o',$lastPath,'-')
    Write-RunLog "CODEX_START | phase=$Phase"
    # 不用 PS5.1 的 native pipeline：它会按当前代码页转码 stdin，中文会变成问号；
    # 也不把 stderr 当作 PowerShell ErrorRecord。用 .NET 进程以 UTF-8 字节写 stdin。
    $psi = New-Object System.Diagnostics.ProcessStartInfo
    $psi.FileName = $CodexExe
    $psi.UseShellExecute = $false
    $psi.CreateNoWindow = $true
    $psi.RedirectStandardInput = $true
    $psi.RedirectStandardOutput = $true
    $psi.RedirectStandardError = $true
    $psi.Arguments = (($args | ForEach-Object { '"' + ([string]$_).Replace('"','\"') + '"' }) -join ' ')
    $proc = New-Object System.Diagnostics.Process
    $proc.StartInfo = $psi
    if (-not $proc.Start()) { throw "CODEX_PROCESS_START_FAILED phase=$Phase" }
    $promptBytes = [System.Text.Encoding]::UTF8.GetBytes($Prompt)
    $proc.StandardInput.BaseStream.Write($promptBytes, 0, $promptBytes.Length)
    $proc.StandardInput.Close()
    $stdoutTask = $proc.StandardOutput.ReadToEndAsync()
    $stderrTask = $proc.StandardError.ReadToEndAsync()
    if (-not $proc.WaitForExit(120000)) {
        $proc.Kill()
        $proc.WaitForExit()
        throw "CODEX_TIMEOUT phase=$Phase"
    }
    $stdout = $stdoutTask.Result
    $stderr = $stderrTask.Result
    $exitCode = $proc.ExitCode
    $proc.Dispose()
    Set-Content -LiteralPath $eventPath -Value ($stderr + $stdout) -Encoding UTF8
    Write-RunLog "CODEX_END | phase=$Phase | exit_code=$exitCode"
    if ($exitCode -ne 0) { throw "CODEX_FAILED phase=$Phase exit_code=$exitCode" }
    if (-not (Test-Path -LiteralPath $lastPath)) { throw "CODEX_NO_FINAL_MESSAGE phase=$Phase" }
    $text = Get-Content -LiteralPath $lastPath -Raw -Encoding UTF8
    $start = $text.IndexOf('{'); $end = $text.LastIndexOf('}')
    if ($start -lt 0 -or $end -le $start) { throw "CODEX_FINAL_NOT_JSON phase=$Phase" }
    try { return $text.Substring($start,$end-$start+1) | ConvertFrom-Json } catch { throw "CODEX_JSON_PARSE_FAILED phase=$Phase" }
}

function Build-GenerationPrompt {
    param([object]$Source, [object]$Inventory, [int]$RoleIndex, [object]$PreviousState)
    $sourceJson = $Source | ConvertTo-Json -Depth 12 -Compress
    $inventoryJson = $Inventory | ConvertTo-Json -Depth 12 -Compress
    $previousJson = $PreviousState | ConvertTo-Json -Depth 8 -Compress
    $templatePath = Join-Path $TaskRoot 'formal-charm-prompt-template.txt'
    if (-not (Test-Path -LiteralPath $templatePath)) { throw "PROMPT_TEMPLATE_NOT_FOUND: $templatePath" }
    $prompt = Get-Content -LiteralPath $templatePath -Raw -Encoding UTF8
    $prompt = $prompt.Replace('{{RUN_ID}}', $RunId)
    $prompt = $prompt.Replace('{{ROLE_INDEX}}', [string]$RoleIndex)
    $prompt = $prompt.Replace('{{VAULT_ROOT}}', $VaultRoot)
    $prompt = $prompt.Replace('{{PROJECT_ROOT}}', $ProjectRoot)
    $prompt = $prompt.Replace('{{SOURCE_JSON}}', $sourceJson)
    $prompt = $prompt.Replace('{{INVENTORY_JSON}}', $inventoryJson)
    $prompt = $prompt.Replace('{{PREVIOUS_JSON}}', $previousJson)
    $prompt = $prompt.Replace('{{SEMANTIC_PROTOCOL}}', $SemanticProtocol)
    $prompt = $prompt.Replace('{{RELATION_PROTOCOL}}', $RelationProtocol)
    $prompt = $prompt.Replace('{{DYNAMIC_PROTOCOL}}', $DynamicProtocol)
    $prompt = $prompt.Replace('{{DYNAMIC_HUB}}', $DynamicHub)
    return $prompt
}

