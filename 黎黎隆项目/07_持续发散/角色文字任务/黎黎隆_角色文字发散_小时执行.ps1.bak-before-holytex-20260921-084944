function Invoke-4090DChannel {
    param([string[]]$ChannelArgs, [string]$LogPath)
    if (-not (Test-Path -LiteralPath $ChannelPython)) { throw "CHANNEL_PYTHON_NOT_FOUND: $ChannelPython" }
    if (-not (Test-Path -LiteralPath $H34090DChannel)) { throw "CHANNEL_SCRIPT_NOT_FOUND: $H34090DChannel" }
    $oldErrorAction = $ErrorActionPreference
    $ErrorActionPreference = 'Continue'
    try {
        $lines = @(& $ChannelPython $H34090DChannel @ChannelArgs 2>&1)
        $exitCode = $LASTEXITCODE
    } catch {
        $lines = @($_.Exception.Message)
        $exitCode = 2
    } finally {
        $ErrorActionPreference = $oldErrorAction
    }
    $output = (@($lines | ForEach-Object { [string]$_ }) -join "`n").Trim()
    if ($LogPath) { Set-Content -LiteralPath $LogPath -Value $output -Encoding UTF8 }
    return [pscustomobject]@{ exit_code=$exitCode; output=$output }
}

function Convert-LastJsonLine {
    param([string]$Text)
    foreach($line in (@($Text -split "`n") | Select-Object -Reverse)) {
        $candidate=[string]$line
        if($candidate.Trim().StartsWith('{')){try{return $candidate.Trim()|ConvertFrom-Json}catch{}}
    }
    return $null
}

function Get-LocalVideoProbe {
    param([string]$VideoPath)
    if(-not $VideoPath -or -not (Test-Path -LiteralPath $VideoPath)){return $null}
    try {
        $probeLines=@(& ffprobe -v error -show_entries format=duration:stream=index,codec_type,codec_name,width,height,avg_frame_rate -of json -- $VideoPath 2>&1)
        $probeText=(@($probeLines|ForEach-Object{[string]$_})-join "`n")
        try{return $probeText|ConvertFrom-Json}catch{return [ordered]@{raw=$probeText}}
    } catch { return [ordered]@{error=$_.Exception.Message} }
}

