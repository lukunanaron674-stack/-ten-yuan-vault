    {"id":"e_hist_1","fromNode":"history","toNode":"era1"},{"id":"e_hist_2","fromNode":"history","toNode":"era2"},{"id":"e_hist_3","fromNode":"history","toNode":"era3"},{"id":"e_hist_4","fromNode":"history","toNode":"era4"},{"id":"e_hist_5","fromNode":"history","toNode":"era5"},{"id":"e_era1_2","fromNode":"era1","toNode":"era2","label":"社会协作"},{"id":"e_era2_3","fromNode":"era2","toNode":"era3","label":"资源工程化"},{"id":"e_era3_4","fromNode":"era3","toNode":"era4","label":"技术进入身体"},{"id":"e_era4_5","fromNode":"era4","toNode":"era5","label":"从修复到设计生命"},
    {"id":"e_tech_1","fromNode":"tech","toNode":"bodytech"},{"id":"e_tech_2","fromNode":"tech","toNode":"functional"},{"id":"e_tech_3","fromNode":"tech","toNode":"exbrain"},{"id":"e_tech_4","fromNode":"tech","toNode":"explorertech"},
    {"id":"e_city_1","fromNode":"city","toNode":"oldcity"},{"id":"e_city_2","fromNode":"city","toNode":"industry"},{"id":"e_city_3","fromNode":"city","toNode":"medical"},{"id":"e_city_4","fromNode":"city","toNode":"academy"},{"id":"e_city_5","fromNode":"city","toNode":"materials"},
