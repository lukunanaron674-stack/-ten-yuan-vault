{
	"nodes":[
		{"id":"no1","type":"text","text":"① 中心转向｜生成结果→制造发散路径","x":869,"y":-1248,"width":320,"height":120,"color":"2"},
		{"id":"no3","type":"text","text":"不先判断属哪个十元 → 同时放十透镜下","x":445,"y":-1553,"width":300,"height":70,"color":"6"},
		{"id":"no4","type":"text","text":"旧入口(zx少女→抽卡) 保留，只算末端工具","x":1289,"y":-1582,"width":300,"height":70,"color":"6"},
		{"id":"no5","type":"text","text":"mapping 降级：服务推理，不再驱动答案","x":2034,"y":-1186,"width":300,"height":70,"color":"6"},
		{"id":"no6","type":"text","text":"② 五层流程｜主轴怎么跑","x":2036,"y":-519,"width":320,"height":120,"color":"4"},
		{"id":"no12","type":"text","text":"③ 三个引擎｜组合工作流","x":1564,"y":1024,"width":320,"height":120,"color":"2"},
		{"id":"no17","type":"text","text":"zx｜改谁拥有最终方向权","x":1555,"y":1956,"width":300,"height":70,"color":"6"},
		{"id":"no18","type":"text","text":"nx｜改谁必须接入既有方向/权限","x":1165,"y":2042,"width":300,"height":70,"color":"6"},
		{"id":"no19","type":"text","text":"zn｜改什么原则还能进未来判断","x":765,"y":2050,"width":300,"height":70,"color":"6"},
		{"id":"no20","type":"text","text":"x｜改什么真正归谁处置","x":371,"y":1980,"width":300,"height":70,"color":"6"},
		{"id":"no21","type":"text","text":"n｜改什么进入后必须被持续承载","x":-2,"y":1836,"width":300,"height":70,"color":"6"},
		{"id":"no22","type":"text","text":"x并z｜改什么内结构转成稳定对外接口","x":-340,"y":1621,"width":300,"height":70,"color":"6"},
		{"id":"no23","type":"text","text":"xn｜改运行流程/阶段/节奏/组织方式","x":-630,"y":1346,"width":300,"height":70,"color":"6"},
		{"id":"no16","type":"text","text":"④ 十条发散操作 · 核心研发 ⭐","x":-605,"y":1019,"width":320,"height":120,"color":"1"},
		{"id":"no24","type":"text","text":"z｜改谁确认什么成立","x":-1262,"y":964,"width":300,"height":96,"color":"6"},
		{"id":"no25","type":"text","text":"xz｜改哪些回头路正在关闭","x":-1360,"y":1180,"width":300,"height":70,"color":"6"},
		{"id":"no7","type":"text","text":"L1 问题拆解｜先拆“普通在哪”（可不用十元）","x":2060,"y":-620,"width":300,"height":60,"color":"6"},
		{"id":"no13","type":"text","text":"① 变量发现器｜哪些能量变的量：权限/资源/时间/关系/资格/流程/身份/回返/窗口","x":1920,"y":680,"width":400,"height":90,"color":"6"},
		{"id":"no10","type":"text","text":"L4 十元交叉｜nx+xz+zn 组合 → 故事胚","x":2660,"y":-459,"width":300,"height":70,"color":"6"},
		{"id":"no11","type":"text","text":"L5 淘汰假发散｜邻居/removal/reverse/反例/证据 → 只留真动结构","x":2356,"y":-240,"width":400,"height":90,"color":"6"},
		{"id":"no31","type":"text","text":"⑥ 应用森林｜角色是其一","x":150,"y":-680,"width":320,"height":120,"color":"3"},
		{"id":"no32","type":"text","text":"角色/故事/题材/世界观/关系/场景/机制/卡点","x":595,"y":-750,"width":300,"height":70,"color":"6"},
		{"id":"no33","type":"text","text":"少女生成器 ＝ 引擎 → 角色应用","x":569,"y":-560,"width":300,"height":60,"color":"1"},
		{"id":"no0","type":"text","text":"🧭 十元发散引擎\n中心＝制造发散路径 · 非生成结果\n\n输入：对象/题材/故事/卡点/问题\n不先贴十元，同时放十透镜下\n角色发散只是其中一个应用","x":504,"y":-88,"width":430,"height":240,"color":"1"},
		{"id":"no29","type":"text","text":"不再驱动答案","x":-190,"y":228,"width":300,"height":70,"color":"6"},
		{"id":"no26","type":"text","text":"nz｜改哪些关系/位置还能真实回返","x":-630,"y":640,"width":300,"height":70,"color":"6"},
		{"id":"no27","type":"text","text":"💡 终局：十组操作成熟→仓库空也自己长树｜应重这10条定稿，非再扩mapping","x":-1060,"y":780,"width":560,"height":110,"color":"1"},
		{"id":"no28","type":"text","text":"⑤ mapping 换位","x":-40,"y":-120,"width":320,"height":120,"color":"2"},
		{"id":"no30","type":"text","text":"只当分支时的参考：案例/边界/反例/具象化","x":-80,"y":-440,"width":300,"height":70,"color":"6"},
		{"id":"no2","type":"text","text":"输入不是十元：对象/题材/故事/卡点/问题（例：普通校园偶像少女）","x":160,"y":-1420,"width":300,"height":70,"color":"6"},
		{"id":"no8","type":"text","text":"L2 十元扫描变量｜同一问题出几类可变位 (zx/nx/xn…)","x":2495,"y":-655,"width":300,"height":70,"color":"6"},
		{"id":"no9","type":"text","text":"L3 继续分叉｜选xz别停，追“为何只剩三个月”→再追“为何解散”","x":2860,"y":-595,"width":300,"height":70,"color":"6"},
		{"id":"no15","type":"text","text":"③ 组合收束器｜zx+xz+zn拼结构，再评分","x":1380,"y":1280,"width":300,"height":70,"color":"6"},
		{"id":"no14","type":"text","text":"② 十元变换器｜从某十元方向改此变量会怎样","x":1820,"y":1315,"width":300,"height":70,"color":"6"}
