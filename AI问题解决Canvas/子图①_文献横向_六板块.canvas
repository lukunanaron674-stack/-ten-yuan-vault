{
	"nodes":[
		{"id":"banner","type":"text","text":"## 子图①｜文献横向·六板块（22 条）　→　返回主图：`论文知识主图_L1`　｜　全文：`相关论文横向盘点_v0.2_STAGING.md`","x":0,"y":-200,"width":2540,"height":110,"color":"6"},
		{"id":"c_main","type":"text","text":"# C｜Prompt 结构化\n（主战场）\n空白在视频行为层","x":0,"y":0,"width":400,"height":140,"color":"4"},
		{"id":"c1","type":"text","text":"C1｜张伟、罗亚远 2026 · 智能系统学报\n图像侧结构化 vs 平铺实证（100 主题×FLUX）\n⭐最直接先例：结构化稳全局版式；视频侧空白＝你的位置","x":480,"y":-30,"width":660,"height":150,"color":"4"},
		{"id":"c2","type":"text","text":"C2｜Liu & Chilton · CHI（arXiv 2109.06977）\n5493 生成实验的 prompt 设计指南\nHCI 侧先例：subject/style 结构化关键词的成败模式","x":480,"y":140,"width":660,"height":150,"color":"4"},
		{"id":"c3","type":"text","text":"C3｜Chong et al. · Design Science 2025\nmono vs multi-criteria prompt 实证\n多准则利可行性/新颖性，单准则利局部审美","x":480,"y":310,"width":660,"height":150,"color":"4"},
		{"id":"c4","type":"text","text":"C5/C6｜SCoPE 2025 + HPT AAAI-24\n粗到细渐进嵌入 / 层级语义图\n长平铺 prompt 有信息损耗（VQA +8）","x":480,"y":480,"width":660,"height":150,"color":"4"},
		{"id":"a_main","type":"text","text":"# A｜动作与运动控制\n主流＝显式几何信号\n不控行为语义","x":1400,"y":0,"width":400,"height":140,"color":"2"},
		{"id":"a1","type":"text","text":"A1｜MotionAgent 2025（arXiv 2502.03207）\n文本→显式运动场→光流控制 I2V\n几何级控制，非行为语义","x":1880,"y":-30,"width":660,"height":150,"color":"2"},
		{"id":"a2","type":"text","text":"A2｜Mojito 2024（arXiv 2412.08948）\n运动轨迹方向 + 强度双控，免训练","x":1880,"y":140,"width":660,"height":150,"color":"2"},
		{"id":"a3","type":"text","text":"A3｜Separate Motion from Appearance（arXiv 2501.16714）\n★「画风层 vs 动作层可分开治」的学术镜像\n模型内部已做解耦；prompt 侧没人做","x":1880,"y":310,"width":660,"height":150,"color":"2"},
		{"id":"a4","type":"text","text":"A4｜VBench · CVPR 2024\n16 维评价含 Human Action\n视频评价标配；维度粗，你做到端点级更细","x":1880,"y":480,"width":660,"height":150,"color":"2"},
		{"id":"b_main","type":"text","text":"# B｜长视频/多镜头一致性\n>16s 行为连贯\n＝学界开放问题","x":0,"y":760,"width":400,"height":140,"color":"3"},
		{"id":"b1","type":"text","text":"B1｜Long-Video Storytelling Survey · ICCVW 2025\n32 篇综述：SOTA 稳定 5-16s\n>16s 外观/布局/多主体行为连贯＝开放问题","x":480,"y":730,"width":660,"height":150,"color":"3"},
		{"id":"b2","type":"text","text":"B2｜Lights, Camera, Consistency（arXiv 2512.16954）\n★「动作跑偏」文献镜像\n撤锚定 7.99→0.55；Script 3.49 < Prompt 4.47","x":480,"y":900,"width":660,"height":150,"color":"3"},
		{"id":"b3","type":"text","text":"B3｜Cel-Animation Survey · ICCVW 2025\n动画流程 GenAI 综述\n未解挑战＝视觉一致性、风格连贯","x":480,"y":1070,"width":660,"height":150,"color":"3"},
		{"id":"b4","type":"text","text":"B4-B6｜工具链：AniDoc CVPR2025（上色）/ ToonCrafter（补间）/ AniSora（动画 T2V）\n→ 分镜到成片的动作环节仍靠人","x":480,"y":1240,"width":660,"height":150,"color":"3"},
		{"id":"e_main","type":"text","text":"# E｜表演/情绪控制\n行为层近邻\n边界＝任务与粒度","x":1400,"y":760,"width":400,"height":140,"color":"6"},
		{"id":"e1","type":"text","text":"E1｜InstructAvatar · AAAI 2025（北大）\n★第二近邻：文本指令控情绪+面部动作\n边界：只做说话头像正脸；全身/多主体/叙事＝空白","x":1880,"y":730,"width":660,"height":150,"color":"6"},
		{"id":"e2","type":"text","text":"E2｜X-Actor · SIGGRAPH Asia 2025\n音频驱动长程情绪表演\n运动潜空间与外观解耦","x":1880,"y":900,"width":660,"height":150,"color":"6"},
		{"id":"e3","type":"text","text":"E3｜Chang · Rutgers 博论 2025\n整体性人类行为条件生成\n情绪同步 + 群体互动（HumanML3D/KIT）","x":1880,"y":1070,"width":660,"height":150,"color":"6"},
		{"id":"b_d_gap","type":"text","text":"# B 续｜动画工具链缺口\n上色补间已自动化\n动作环节仍靠人","x":0,"y":1520,"width":400,"height":140,"color":"3"},
		{"id":"d_main","type":"text","text":"# D｜评价方法\n方法章每一步\n都有已发表先例","x":1400,"y":1520,"width":400,"height":140,"color":"5"},
		{"id":"d1","type":"text","text":"D1｜VBench 2.0：VLM 二元问答\n缺陷：yes-bias、低分辨率漏时序失效\n你的主观盲评线＝对其自动化盲区的补充","x":1880,"y":1490,"width":660,"height":150,"color":"5"},
		{"id":"d2","type":"text","text":"D2｜AIGV-Assessor · 上海交大\n36576 片 / 37 万人评\nAIGV 头部失真＝不自然运动","x":1880,"y":1660,"width":660,"height":150,"color":"5"},
		{"id":"d3","type":"text","text":"D3｜WorldJen 2026\n2696 成对标注 + Bradley-Terry 分层\n评委间一致率 66.9%","x":1880,"y":1830,"width":660,"height":150,"color":"5"},
		{"id":"d5","type":"text","text":"D5｜Claru 工业人评案例\nα>0.70 筛指标 + ELO 瑞士制，39000 对\n★直接支撑你的双评 + α≥0.80 + bootstrap CI","x":1880,"y":2000,"width":660,"height":150,"color":"5"},
		{"id":"f_main","type":"text","text":"# F｜中文理论场域\n中文核心理论锚点\n答辩话语来源","x":0,"y":2280,"width":400,"height":140,"color":"1"},
		{"id":"f1","type":"text","text":"F1｜施畅、谢忠正《作为技术图像的AIGC》\n北京电影学院学报 2024(11):14-25（CSSCI）","x":480,"y":2250,"width":660,"height":150,"color":"1"},
		{"id":"f2","type":"text","text":"F2｜列夫·马诺维奇《AI图像与生成媒介》\n北电学报 2024(9):4-13","x":480,"y":2420,"width":660,"height":150,"color":"1"},
		{"id":"f3","type":"text","text":"F3｜谢建华《计算创造力》北电学报 2024(11)　｜　F4｜《当代电影》2024(11) Sora 创作转向","x":480,"y":2590,"width":660,"height":150,"color":"1"},
