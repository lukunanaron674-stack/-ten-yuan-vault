	"metadata":{"version":"3.0","role":"SOCIAL_TO_US","score_scale":"0-100","center2":"R1-R4 DONE","center3":"R1-R3 DONE","next_phase":"LEARNING_IMPLEMENTATION_AND_VALIDATION","note":"Center 2 controls WHICH/WHEN; Center 3 controls WHO/VERIFY. Keep them separate."}
